PORT=9000
# Match infra/.env. URL-encode passwords in this connection URL.
DATABASE_URL=postgres://oloye:replace-with-local-password@localhost:5432/oloye
STORE_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000
# Generate independent random secrets of at least 32 characters. No fallback secrets.
JWT_SECRET=replace-with-random-jwt-secret
COOKIE_SECRET=replace-with-random-cookie-secret
