# Private SvelteKit variables. Never expose admin credentials to the browser.
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_REQUEST_TIMEOUT_MS=5000
# Optional until Store API requests are introduced. Create through Medusa Admin.
MEDUSA_PUBLISHABLE_KEY=

# adapter-node production server (pnpm start); Vite development uses port 5173.
HOST=127.0.0.1
PORT=5173
ORIGIN=http://localhost:5173
